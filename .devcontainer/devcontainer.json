{
  "name": "WebPython",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "WebPython",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements.txt"
}
