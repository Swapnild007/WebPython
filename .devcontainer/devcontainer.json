{
  "name": "WebPython - Python Learning",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "WebPython",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "postCreateCommand": "python --version && python -m pip install -r backend/requirements.txt"
}
